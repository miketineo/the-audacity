# The Audacity v2 — build-time environment.
# Copy to `.env` (gitignored) for local builds, or set these as Cloudflare Pages
# build env vars for the deployed /v2 build.

# PostHog project API key for project "The Audacity" (id 160291, EU cloud).
# This is the PUBLIC client key (phc_…), safe to ship in client JS. It is NOT a
# personal/admin key. Astro inlines any PUBLIC_* var into the client bundle.
# Find it: https://eu.posthog.com  ->  Project settings  ->  Project API Key.
PUBLIC_POSTHOG_KEY=phc_REPLACE_WITH_POSTHOG_PROJECT_KEY
