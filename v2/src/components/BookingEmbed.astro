---
/**
 * BookingEmbed.astro: the single, swap-ready booking surface.
 *
 * Provider: Cal.com inline embed (switched from the Google Calendar iframe on
 * 2026-07-07: Google's page could not be themed and clashed with dark mode).
 *
 * What this gives us over the old iframe:
 *   - theme sync: the embed follows the site's light/dark toggle live
 *     (MutationObserver on <html data-theme>), monochrome brand color per theme
 *   - real completion tracking: Cal's `bookingSuccessful` event fires
 *     `book_call_completed` (the Google iframe had no callback at all)
 *   - brand identity: the page shows The Audacity, not a personal calendar
 *
 * `book_call_started` still fires once when the booking surface first enters
 * the viewport. Availability is backed by Google Calendar via Cal.com.
 *
 * Configured 2026-07-07: event type "Diagnostic call" (id 6241493) created via
 * the Cal.com v2 API on account the-audacity-io (Google Calendar connected,
 * Meet links, 25 min, day cap 3, qualifier question). API key in Vault at
 * secret/projects/theaudacity/cal.
 */
const CAL_LINK = 'the-audacity-io/diagnostic-call';
const CAL_NAMESPACE = 'diagnostic-call';
const PROVIDER = 'cal.com';

export interface Props {
  /** Accessible region title. */
  title?: string;
  /** Fallback contact address shown until the link is configured. */
  email?: string;
}
const { title = 'Book a diagnostic call', email = 'obviously@theaudacity.io' } = Astro.props;

// Until the real link is pasted, render a graceful fallback instead of a broken
// embed so the page is correct in every environment (incl. QA + local).
const configured = !CAL_LINK.includes('REPLACE_WITH_CAL_LINK');
---
<div
  class="booking"
  data-booking
  data-provider={PROVIDER}
  data-configured={String(configured)}
  data-cal-link={configured ? CAL_LINK : undefined}
  data-cal-namespace={CAL_NAMESPACE}
>
  {configured ? (
    <div class="booking__frame" id="cal-inline" aria-label={title}></div>
  ) : (
    <div class="booking__fallback" role="note">
      <p class="booking__fallback-title">We book calls by email right now.</p>
      <p class="text-dim">
        Email{' '}
        <a href={`mailto:${email}?subject=Diagnostic%20call`}>{email}</a>{' '}
        with two times that suit you and we confirm within one business day.
      </p>
    </div>
  )}
  <p class="booking__alt text-dim">
    Prefer to do this by email?{' '}
    <a href={`mailto:${email}?subject=Diagnostic%20call`}>Reach us directly</a>.
  </p>
</div>

<script>
  // Cal.com inline embed with live theme sync + event tracking. Loads the
  // third-party script only when the booking surface exists AND is configured
  // (functional embed, same class as the previous Google iframe). Never
  // throws, never blocks render; the email fallback below stays reachable.
  (function () {
    const el = document.querySelector('[data-booking]');
    if (!el || el.getAttribute('data-configured') !== 'true') return;

    const calLink = el.getAttribute('data-cal-link');
    const ns = el.getAttribute('data-cal-namespace') || 'booking';
    if (!calLink) return;

    const track = (event: string, props?: Record<string, unknown>) => {
      const merged = Object.assign({ provider: el.getAttribute('data-provider') }, props);
      try { (window as any).audacityTrack?.(event, merged); } catch (e) {}
    };

    // Current site theme ('light' | 'dark'), resolved by the no-flash script.
    const siteTheme = () =>
      document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
    // Monochrome brand: ink on light, near-white on dark (mirrors --accent).
    const brand = () => (siteTheme() === 'dark' ? '#ececec' : '#0e0e10');

    // ---- Official Cal.com loader snippet (namespaced) ----
    /* eslint-disable */
    (function (C: any, A: string, L: string) {
      let p = function (a: any, ar: any) { a.q.push(ar); };
      let d = C.document;
      C.Cal = C.Cal || function () {
        let cal = C.Cal; let ar = arguments;
        if (!cal.loaded) {
          cal.ns = {}; cal.q = cal.q || [];
          d.head.appendChild(d.createElement('script')).src = A;
          cal.loaded = true;
        }
        if (ar[0] === L) {
          const api: any = function () { p(api, arguments); };
          const namespace = ar[1]; api.q = api.q || [];
          if (typeof namespace === 'string') {
            cal.ns[namespace] = cal.ns[namespace] || api;
            p(cal.ns[namespace], ar); p(cal, ['initNamespace', namespace]);
          } else p(cal, ar);
          return;
        }
        p(cal, ar);
      };
    })(window as any, 'https://app.cal.com/embed/embed.js', 'init');
    /* eslint-enable */

    const Cal = (window as any).Cal;
    Cal('init', ns, { origin: 'https://cal.com' });
    Cal.ns[ns]('inline', {
      elementOrSelector: '#cal-inline',
      calLink,
      config: { layout: 'month_view', theme: siteTheme() },
    });
    Cal.ns[ns]('ui', {
      theme: siteTheme(),
      styles: { branding: { brandColor: brand() } },
      hideEventTypeDetails: false,
    });

    // Completion tracking: Cal emits bookingSuccessful from inside the embed.
    Cal.ns[ns]('on', {
      action: 'bookingSuccessful',
      callback: () => track('book_call_completed'),
    });

    // Live theme sync: follow the site's toggle (ThemeToggle sets <html data-theme>).
    new MutationObserver(() => {
      try {
        Cal.ns[ns]('ui', { theme: siteTheme(), styles: { branding: { brandColor: brand() } } });
      } catch (e) {}
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    // book_call_started once, when the booking surface first becomes visible.
    // Guarded by a local flag rather than io.disconnect(): the event may still
    // be sitting in the analytics queue awaiting consent, and disconnecting
    // leaves nothing to retry with.
    let fired = false;
    const fire = () => {
      if (fired) return;
      fired = true;
      track('book_call_started');
    };
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) fire();
        });
      }, { threshold: 0.4 });
      io.observe(el);
    } else {
      fire();
    }
  })();
</script>

<style>
  .booking { display: grid; gap: var(--space-sm); }
  .booking__frame {
    width: 100%;
    min-height: clamp(560px, 78vh, 760px);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--surface);
    box-shadow: var(--shadow);
  }

  .booking__fallback {
    border: 1px dashed var(--border-strong);
    border-radius: var(--radius-lg);
    background: var(--surface-2);
    padding: var(--space-lg);
    display: grid;
    gap: var(--space-2xs);
  }
  .booking__fallback-title { font-weight: 650; }

  .booking__alt { font-size: var(--text-sm); }
</style>
