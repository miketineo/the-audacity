---
/**
 * Footer.astro — legal, contact, llms.txt link, cookie settings.
 *
 * "Cookie settings" re-opens ConsentBanner via the 'audacity:open-consent'
 * event (ConsentBanner listens). llms.txt + agent-manifest are produced by the
 * SEO agent at site root; linked here with absolute base. No props.
 */
const base = import.meta.env.BASE_URL;
const year = new Date().getFullYear();
const links = [
  { label: 'Home', href: base },
  { label: 'Work', href: `${base}work/` },
  { label: 'Contact', href: `${base}contact/` },
];
---
<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <span class="brand__wordmark">The Audacity</span>
      <p class="text-dim site-footer__tag">
        An AI-first software studio. Senior judgment, AI acceleration, products shipped to production.
      </p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <ul role="list">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </nav>

    <div class="site-footer__meta">
      <a href="mailto:obviously@theaudacity.io">obviously@theaudacity.io</a>
      <a href="https://audacious.theaudacity.io">The Audacious</a>
      <a href={`${base}privacy/`}>Privacy</a>
      <a href={`${base}llms.txt`}>llms.txt</a>
      <button type="button" class="site-footer__cookies" id="open-cookie-settings">
        Cookie settings
      </button>
    </div>
  </div>

  <div class="container site-footer__legal">
    <p class="eyebrow">© {year} The Audacity · P. IVA IT04098710926</p>
    <p class="eyebrow">Built with audacity.</p>
  </div>
</footer>

<script>
  document.getElementById('open-cookie-settings')?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('audacity:open-consent'));
  });
</script>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background: var(--surface);
    padding-block: var(--space-xl) var(--space-lg);
  }
  .site-footer__inner {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: var(--space-lg);
    align-items: start;
  }
  .brand__wordmark {
    font-family: var(--font-display);
    font-weight: 900;
    font-size: 1.5rem;
    letter-spacing: var(--tracking-display);
  }
  .site-footer__tag { margin-top: var(--space-2xs); font-size: var(--text-sm); max-width: 38ch; }

  .site-footer__nav ul,
  .site-footer__meta {
    display: flex;
    flex-direction: column;
    gap: var(--space-2xs);
  }
  .site-footer__nav a,
  .site-footer__meta a,
  .site-footer__cookies {
    font-size: var(--text-sm);
    color: var(--text-dim);
    text-decoration: none;
    text-align: left;
    width: fit-content;
    transition: color var(--dur-fast) var(--ease);
  }
  .site-footer__nav a:hover,
  .site-footer__meta a:hover,
  .site-footer__cookies:hover { color: var(--text); }

  .site-footer__legal {
    display: flex;
    justify-content: space-between;
    gap: var(--space-sm);
    margin-top: var(--space-xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }

  @media (max-width: 52rem) {
    .site-footer__inner { grid-template-columns: 1fr 1fr; }
    .site-footer__brand { grid-column: 1 / -1; }
  }
  @media (max-width: 32rem) {
    .site-footer__inner { grid-template-columns: 1fr; }
    .site-footer__legal { flex-direction: column; }
  }
</style>
