---
/**
 * Home (/v2/): the studio's thin, confident sales surface.
 *
 * One scroll: hero -> the stack we build on -> the Studio Sprint offer (with
 * prices) -> straight answers (FAQ, when content provides it) -> how it works
 * -> the two proofs (teasers) -> who it's not for -> a closing book-a-call band.
 *
 * Consumes shared content: site.json, offer.json, proof.json, pages.json,
 * and faq.json when present (optional, loaded via glob so its absence never
 * breaks the build). Consumes shared components: Base, Logo, Button.
 * SEO via Base props; Organization + Service JSON-LD in the `jsonld` slot.
 *
 * Light-first, super-minimalist, MONOCHROME. The accent token is ink (flips
 * per theme): primary CTAs, one hero mark, section eyebrows' tick, and the
 * flagship package's hairline. One job at a time, never a field. Motion is a
 * single purposeful scroll-reveal with a reduced-motion and no-JS fallback
 * (content is fully visible unless JS opts into the animation).
 */
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import Button from '../components/Button.astro';
import OrganizationLD from '../components/jsonld/Organization.astro';
import ServiceLD from '../components/jsonld/Service.astro';

import site from '../content/site.json';
import offer from '../content/offer.json';
import proof from '../content/proof.json';
import pages from '../content/pages.json';

const base = import.meta.env.BASE_URL; // '/v2/'
const href = (p: string) => `${base}${p}`; // content hrefs are base-relative

const home = pages.home;
const { packages, audit, differentiator, notFor } = offer;

// FAQ content is owned by src/content/faq.json (authored separately). Load it
// via glob so the page builds cleanly whether or not the file exists yet, and
// tolerate either { items: [...] } or a bare array, with q/a or question/answer keys.
type FaqItem = { q: string; a: string };
const faqModules = import.meta.glob<{ default: unknown }>('../content/faq.json', { eager: true });
const faqRaw = Object.values(faqModules)[0]?.default as
  | { eyebrow?: string; title?: string; items?: Record<string, string>[] }
  | Record<string, string>[]
  | undefined;
const faqList = Array.isArray(faqRaw) ? faqRaw : (faqRaw?.items ?? []);
const faqItems: FaqItem[] = faqList
  .map((it) => ({ q: it.q ?? it.question ?? '', a: it.a ?? it.answer ?? '' }))
  .filter((it) => it.q && it.a);
const faqEyebrow = (!Array.isArray(faqRaw) && faqRaw?.eyebrow) || 'FAQ';
const faqTitle = (!Array.isArray(faqRaw) && faqRaw?.title) || 'Straight answers';

const stack = ['Web', 'Mobile', 'Managed backend', 'AI assistant layer', 'Continuous delivery', 'Production deployment'];
---
<Base
  title={home.seo.title}
  description={home.seo.description}
  path="/"
>
  <Logo slot="logo" direction="c" />

  {/* Opt into scroll-reveal only when JS is present: no-JS keeps content visible. */}
  <script slot="head" is:inline>document.documentElement.classList.add('js');</script>

  {/* Structured data: Organization + the Studio Sprint Service (one source of
      truth in src/components/jsonld/, fed from content JSON). */}
  <OrganizationLD slot="jsonld" />
  <ServiceLD slot="jsonld" />

  {/* ===================== HERO ===================== */}
  <section class="hero">
    <div class="container hero__inner">
      <p class="eyebrow eyebrow--mark" data-reveal>{home.hero.eyebrow}</p>
      <h1 class="hero__headline" data-reveal>
        {home.hero.headline}<span class="dot" aria-hidden="true"></span>
      </h1>
      <p class="hero__lede text-dim" data-reveal>{home.hero.lede}</p>
      <div class="hero__cta" data-reveal>
        <Button href={href(home.hero.ctaPrimary.href)} variant="primary" size="lg" data-cta="hero-book-call">
          {home.hero.ctaPrimary.label}
        </Button>
        <Button href={href(home.hero.ctaSecondary.href)} variant="secondary" size="lg" data-cta="hero-see-work">
          {home.hero.ctaSecondary.label}
        </Button>
      </div>
    </div>

    {/* The repeatable stack, doubling as a quiet proof line. */}
    <div class="container">
      <ul class="stack" role="list" aria-label="The stack under every build" data-reveal>
        {stack.map((s) => <li class="stack__item">{s}</li>)}
      </ul>
    </div>
  </section>

  {/* ===================== OFFER ===================== */}
  <section class="section offer" id="offer" aria-labelledby="offer-h">
    <div class="container">
      <header class="section__head">
        <p class="eyebrow eyebrow--mark" data-reveal>{offer.eyebrow}</p>
        <h2 id="offer-h" data-reveal>{offer.title}</h2>
        <p class="section__lede text-dim" data-reveal>{offer.lede}</p>
      </header>

      <div class="differentiator" data-reveal>
        <h3 class="differentiator__title">{differentiator.title}</h3>
        <p class="text-dim">{differentiator.body}</p>
      </div>

      <ul class="packages" role="list">
        {packages.map((p) => (
          <li class={`pkg${p.id === 'launch' ? ' pkg--flagship' : ''}`} data-reveal>
            {p.id === 'launch' && <span class="pkg__flag">Flagship</span>}
            <div class="pkg__top">
              <h3 class="pkg__name">{p.name}</h3>
              <p class="pkg__scope text-dim">{p.scope}</p>
            </div>
            <p class="pkg__price">{p.priceFrom}</p>
            <p class="pkg__meta">{p.timeline} · {p.model}</p>
            <p class="pkg__summary">{p.summary}</p>
            <ul class="pkg__includes" role="list">
              {p.includes.map((inc) => <li>{inc}</li>)}
            </ul>
            <div class="pkg__cta">
              <Button
                href={href('contact/#book')}
                variant={p.id === 'launch' ? 'primary' : 'secondary'}
                size="sm"
                data-cta={`pkg-${p.id}-book-call`}
              >Book a call</Button>
            </div>
          </li>
        ))}
      </ul>

      {/* Secondary funnel-in: the audit, framed as the low-commitment first step. */}
      <div class="audit" data-reveal>
        <div class="audit__copy">
          <p class="eyebrow audit__eyebrow">{audit.eyebrow}</p>
          <h3 class="audit__name">{audit.name}</h3>
          <p class="text-dim">{audit.summary}</p>
          <p class="audit__funnel text-dim">{audit.funnel}</p>
          {audit.crosslink && (
            <p class="audit__funnel text-dim">
              {audit.crosslink.lead}{' '}
              <a href={audit.crosslink.href} rel="noopener">{audit.crosslink.label} &rarr;</a>
            </p>
          )}
        </div>
        <div class="audit__aside">
          <p class="audit__price">{audit.priceFrom}</p>
          <p class="pkg__meta">{audit.timeline} · {audit.model}</p>
          <Button href={href('contact/?interest=audit')} variant="ghost" size="sm" data-cta="offer-start-audit">
            {site.cta.startAudit} &rarr;
          </Button>
        </div>
      </div>

      <p class="change-order text-dim" data-reveal>
        <strong>{offer.changeOrder.title}.</strong> {offer.changeOrder.body}
      </p>
    </div>
  </section>

  {/* ===================== FAQ (renders only when faq.json exists) ===================== */}
  {faqItems.length > 0 && (
    <section class="section faq" id="faq" aria-labelledby="faq-h">
      <div class="container">
        <header class="section__head">
          <p class="eyebrow eyebrow--mark" data-reveal>{faqEyebrow}</p>
          <h2 id="faq-h" data-reveal>{faqTitle}</h2>
        </header>
        <div class="faq__list">
          {faqItems.map((item) => (
            <details class="faq__item" data-reveal>
              <summary class="faq__q">
                <span>{item.q}</span>
                <span class="faq__marker" aria-hidden="true"></span>
              </summary>
              <p class="faq__a text-dim">{item.a}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  {/* ===================== PROCESS ===================== */}
  <section class="section process" aria-labelledby="process-h">
    <div class="container">
      <header class="section__head">
        <p class="eyebrow eyebrow--mark" data-reveal>{home.process.eyebrow}</p>
        <h2 id="process-h" data-reveal>{home.process.title}</h2>
      </header>
      <ol class="steps" role="list">
        {home.process.steps.map((s) => (
          <li class="step" data-reveal>
            <span class="step__n" aria-hidden="true">{s.n}</span>
            <h3 class="step__title">{s.title}</h3>
            <p class="text-dim">{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  {/* ===================== PROOF TEASER ===================== */}
  <section class="section proof" aria-labelledby="proof-h">
    <div class="container">
      <header class="section__head">
        <p class="eyebrow eyebrow--mark" data-reveal>{home.proofTeaser.eyebrow}</p>
        <h2 id="proof-h" data-reveal>{home.proofTeaser.title}</h2>
        <p class="section__lede text-dim" data-reveal>{home.proofTeaser.body}</p>
      </header>

      <ul class="proofs" role="list">
        {proof.items.map((it) => (
          <li class="proof-card" data-reveal>
            <p class="proof-card__kind eyebrow">{it.kind}</p>
            <h3 class="proof-card__name">{it.name}</h3>
            <p class="proof-card__one">{it.oneLiner}</p>
            <p class="proof-card__summary text-dim">{it.summary}</p>
            <ul class="chips" role="list" aria-label="Stack">
              {it.stack.map((s) => <li class="chip">{s}</li>)}
            </ul>
          </li>
        ))}
      </ul>

      <div class="proof__more" data-reveal>
        <Button href={href(home.proofTeaser.cta.href)} variant="secondary" size="md" data-cta="proof-see-work">
          {home.proofTeaser.cta.label} &rarr;
        </Button>
      </div>
    </div>
  </section>

  {/* ===================== WHO IT'S NOT FOR ===================== */}
  <section class="section notfor" aria-labelledby="notfor-h">
    <div class="container notfor__inner">
      <div class="notfor__head">
        <p class="eyebrow eyebrow--mark" data-reveal>Honest fit</p>
        <h2 id="notfor-h" data-reveal>{notFor.title}</h2>
      </div>
      <ul class="notfor__list" role="list">
        {notFor.items.map((item) => (
          <li class="notfor__item" data-reveal>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  {/* ===================== CLOSING CTA BAND ===================== */}
  <section class="cta-band" aria-labelledby="ctaband-h">
    <div class="container cta-band__inner" data-reveal>
      <h2 id="ctaband-h" class="cta-band__title">{home.ctaBand.title}</h2>
      <p class="cta-band__body text-dim">{home.ctaBand.body}</p>
      <Button href={href(home.ctaBand.cta.href)} variant="primary" size="lg" data-cta="band-book-call">
        {home.ctaBand.cta.label}
      </Button>
    </div>
  </section>
</Base>

<style>
  /* ---------- shared section rhythm ---------- */
  .section { padding-block: var(--space-2xl); }
  .section + .section { border-top: 1px solid var(--border); }

  .section__head { max-width: 60ch; margin-bottom: var(--space-xl); display: grid; gap: var(--space-sm); }
  .section__lede { font-size: var(--text-md); }

  /* eyebrow with a small lime tick mark (a "key mark", used sparingly) */
  .eyebrow--mark { display: inline-flex; align-items: center; gap: 0.6em; }
  .eyebrow--mark::before {
    content: ''; width: 1.5rem; height: 2px;
    background: var(--accent); border-radius: 2px;
  }

  /* ---------- hero ---------- */
  .hero { padding-block: clamp(var(--space-xl), 6vw, var(--space-3xl)) var(--space-2xl); }
  .hero__inner { display: grid; gap: var(--space-md); }
  .hero__headline {
    font-size: var(--text-3xl);
    max-width: 16ch;
    margin-top: var(--space-2xs);
  }
  .hero__headline .dot {
    display: inline-block;
    width: 0.5em; height: 0.5em;
    margin-left: 0.12em;
    background: var(--accent);
    border-radius: 2px;
    vertical-align: baseline;
  }
  .hero__lede { font-size: var(--text-md); max-width: 56ch; }
  .hero__cta { display: flex; flex-wrap: wrap; gap: var(--space-sm); margin-top: var(--space-2xs); }

  .stack {
    display: flex; flex-wrap: wrap; gap: var(--space-2xs) var(--space-md);
    margin-top: var(--space-2xl);
    padding-top: var(--space-md);
    border-top: 1px solid var(--border);
  }
  .stack__item {
    font-family: var(--font-mono);
    font-size: var(--text-xs);
    letter-spacing: 0.04em;
    color: var(--text-dim);
    text-transform: uppercase;
  }
  .stack__item + .stack__item::before {
    content: '·'; margin-right: var(--space-md); color: var(--border-strong);
  }

  /* ---------- offer ---------- */
  .differentiator {
    display: grid; gap: var(--space-xs);
    max-width: 70ch;
    margin-bottom: var(--space-xl);
  }
  .differentiator__title { font-size: var(--text-lg); }

  .packages {
    display: grid; gap: var(--space-md);
    grid-template-columns: repeat(3, 1fr);
    align-items: start;
  }
  .pkg {
    position: relative;
    display: grid; gap: var(--space-xs);
    align-content: start;
    padding: var(--space-lg) var(--space-md);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    height: 100%;
  }
  .pkg--flagship { border-color: var(--border-strong); box-shadow: var(--shadow); }
  .pkg--flagship::before {
    content: ''; position: absolute; inset: 0 auto auto 0;
    width: 100%; height: 3px;
    background: var(--accent);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
  }
  .pkg__flag {
    position: absolute; top: var(--space-md); right: var(--space-md);
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: var(--tracking-label); text-transform: uppercase;
    color: var(--text-dim);
  }
  .pkg__top { display: grid; gap: var(--space-3xs); }
  .pkg__name { font-size: var(--text-md); font-family: var(--font-body); font-weight: 650; letter-spacing: 0; }
  .pkg__scope { font-size: var(--text-sm); }
  .pkg__price {
    font-family: var(--font-display); font-weight: 900;
    font-size: var(--text-xl); line-height: 1; letter-spacing: var(--tracking-display);
    margin-top: var(--space-2xs);
  }
  .pkg__meta {
    font-family: var(--font-mono); font-size: var(--text-xs);
    letter-spacing: 0.03em; color: var(--text-dim);
  }
  .pkg__summary { font-size: var(--text-sm); }
  .pkg__includes { display: grid; gap: var(--space-2xs); margin-top: var(--space-2xs); }
  .pkg__includes li {
    position: relative; padding-left: 1.4em;
    font-size: var(--text-sm); color: var(--text);
  }
  .pkg__includes li::before {
    content: ''; position: absolute; left: 0; top: 0.62em;
    width: 0.7em; height: 2px; background: var(--border-strong); border-radius: 2px;
  }
  .pkg__cta { margin-top: var(--space-sm); }

  /* audit funnel-in */
  .audit {
    display: grid; grid-template-columns: 1fr auto; gap: var(--space-lg);
    align-items: center;
    margin-top: var(--space-lg);
    padding: var(--space-lg);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .audit__copy { display: grid; gap: var(--space-xs); max-width: 62ch; }
  .audit__eyebrow { color: var(--text-dim); }
  .audit__name { font-size: var(--text-lg); }
  .audit__funnel { font-size: var(--text-sm); }
  .audit__aside { display: grid; gap: var(--space-2xs); justify-items: start; min-width: 9rem; }
  .audit__price {
    font-family: var(--font-display); font-weight: 900;
    font-size: var(--text-lg); line-height: 1; letter-spacing: var(--tracking-display);
  }

  .change-order {
    margin-top: var(--space-lg); max-width: 72ch; font-size: var(--text-sm);
  }
  .change-order strong { color: var(--text); }

  /* ---------- FAQ (details/summary, plain monochrome list) ---------- */
  .faq__list { max-width: 72ch; }
  .faq__item { border-top: 1px solid var(--border); }
  .faq__item:last-child { border-bottom: 1px solid var(--border); }
  .faq__q {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: var(--space-sm);
    padding-block: var(--space-sm);
    font-weight: 650;
    font-size: var(--text-md);
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }
  .faq__q:hover { color: var(--text); }
  .faq__q:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
    border-radius: var(--radius-sm);
  }
  /* plus/minus marker drawn in ink, no icon font */
  .faq__marker {
    position: relative;
    flex: 0 0 auto;
    width: 0.85em; height: 0.85em;
    align-self: center;
  }
  .faq__marker::before,
  .faq__marker::after {
    content: '';
    position: absolute; inset: 0;
    margin: auto;
    background: var(--text-dim);
    border-radius: 2px;
  }
  .faq__marker::before { width: 100%; height: 2px; }
  .faq__marker::after {
    width: 2px; height: 100%;
    transition: transform var(--dur-fast) var(--ease);
  }
  .faq__item[open] .faq__marker::after { transform: scaleY(0); }
  @media (prefers-reduced-motion: reduce) {
    .faq__marker::after { transition: none; }
  }
  .faq__a {
    padding-block: 0 var(--space-md);
    max-width: 62ch;
    font-size: var(--text-base);
  }

  /* ---------- process ---------- */
  .steps {
    display: grid; gap: var(--space-lg);
    grid-template-columns: repeat(3, 1fr);
    counter-reset: step;
  }
  .step { display: grid; gap: var(--space-xs); align-content: start; }
  .step__n {
    font-family: var(--font-mono); font-weight: 700;
    font-size: var(--text-md); color: var(--text-dim);
    letter-spacing: 0.04em;
  }
  .step__title { font-size: var(--text-lg); }

  /* ---------- proof ---------- */
  .proofs { display: grid; gap: var(--space-md); grid-template-columns: repeat(2, 1fr); }
  .proof-card {
    display: grid; gap: var(--space-sm); align-content: start;
    padding: var(--space-lg);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }
  .proof-card__kind { color: var(--text-dim); }
  .proof-card__name { font-size: var(--text-xl); }
  .proof-card__one { font-size: var(--text-md); font-weight: 600; }
  .proof-card__summary { font-size: var(--text-sm); }
  .chips { display: flex; flex-wrap: wrap; gap: var(--space-2xs); margin-top: var(--space-2xs); }
  .chip {
    font-family: var(--font-mono); font-size: var(--text-xs);
    padding: 0.3em 0.7em;
    border: 1px solid var(--border); border-radius: 999px;
    color: var(--text-dim);
  }
  .proof__more { margin-top: var(--space-xl); }

  /* ---------- who it's not for ---------- */
  .notfor__inner { display: grid; grid-template-columns: minmax(0, 22rem) 1fr; gap: var(--space-xl); align-items: start; }
  .notfor__head { display: grid; gap: var(--space-sm); }
  .notfor__list { display: grid; gap: 0; }
  .notfor__item {
    max-width: none;
    font-size: var(--text-md);
    padding-block: var(--space-sm);
    border-top: 1px solid var(--border);
    color: var(--text);
  }
  .notfor__item:last-child { border-bottom: 1px solid var(--border); }

  /* ---------- closing CTA band ---------- */
  .cta-band { padding-block: var(--space-2xl); border-top: 1px solid var(--border); }
  .cta-band__inner {
    display: grid; gap: var(--space-md); justify-items: start;
    max-width: 46ch;
  }
  .cta-band__title { font-size: var(--text-2xl); }
  .cta-band__body { font-size: var(--text-md); }

  /* ===================== responsive ===================== */
  @media (max-width: 60rem) {
    .packages { grid-template-columns: 1fr; }
    .steps { grid-template-columns: 1fr; gap: var(--space-md); }
    .proofs { grid-template-columns: 1fr; }
    .notfor__inner { grid-template-columns: 1fr; gap: var(--space-md); }
    .audit { grid-template-columns: 1fr; align-items: start; gap: var(--space-md); }
    .audit__aside { justify-items: start; }
  }

  @media (max-width: 36rem) {
    .hero__headline { max-width: none; }
    .stack__item { font-size: 0.72rem; }
  }

  /* ===================== motion: scroll reveal =====================
     Default (no-JS / reduced-motion): everything visible.
     With JS (html.js), pre-reveal state hides, observer adds .is-visible. */
  :global(html.js) [data-reveal] {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    will-change: opacity, transform;
  }
  :global(html.js) [data-reveal].is-visible {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) [data-reveal] { opacity: 1; transform: none; transition: none; }
  }
</style>

<script>
  // Purposeful reveal: stagger elements into view once, then stop observing.
  // Reduced-motion users get the static (already-visible) state from CSS.
  (function () {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const els = Array.from(document.querySelectorAll('[data-reveal]'));
    if (reduce.matches || !('IntersectionObserver' in window)) {
      els.forEach((el) => el.classList.add('is-visible'));
      return;
    }
    const io = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          io.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    els.forEach((el) => io.observe(el));
  })();
</script>
